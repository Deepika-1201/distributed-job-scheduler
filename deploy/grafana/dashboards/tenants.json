{
  "uid": "js-tenants",
  "title": "Job scheduler: tenants",
  "description": "Per-tenant demand, admission and running work.",
  "tags": [
    "jobscheduler"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Platform Prometheus",
          "value": "platform-prometheus"
        },
        "hide": 0
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(jobs_submitted_total, tenant)",
          "refId": "vars"
        },
        "definition": "label_values(jobs_submitted_total, tenant)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "links": [
    {
      "title": "Job scheduler",
      "type": "dashboards",
      "tags": [
        "jobscheduler"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Demand",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Submitted by job type",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(jobs_submitted_total{tenant=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Submitted by priority",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (priority) (rate(jobs_submitted_total{tenant=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{priority}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Future work created",
      "description": "Delayed submissions, and fires materialized from schedules.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(jobs_scheduled_total{tenant=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{source}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Rejected by reason",
      "description": "rate_limited and quota_exceeded are the tenant's quotas; overloaded is load shedding.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (tenant, reason) (rate(jobs_rejected_total{tenant=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{tenant}} {{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Running",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Running jobs by pool",
      "description": "Compare with the tenant's max_running quota (GET /v1/tenants/{id}/quotas).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (tenant, pool) (jobs_running{tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}} in {{pool}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    }
  ]
}
